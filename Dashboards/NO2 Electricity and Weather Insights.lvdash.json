{
  "datasets": [
    {
      "name": "e53b8d8e",
      "displayName": "price_by_temperature_band",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.price_by_temperature_band",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ]
      }
    },
    {
      "name": "c3f9e9bd",
      "displayName": "executive_summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.executive_summary",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "dd5d92e7",
      "displayName": "model_feature_importance",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.model_feature_importance",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "feature_label",
            "expr": "CASE source.feature\n  WHEN 'air_temperature_c' THEN 'Air Temperature'\n  WHEN 'wind_speed_mps' THEN 'Wind Speed'\n  WHEN 'hour' THEN 'Hour of Day'\n  WHEN 'month' THEN 'Month'\n  ELSE source.feature\nEND"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "model_metrics",
      "displayName": "model_performance_metrics",
      "config": {
        "version": "1.1",
        "source": "SELECT 0.1972 AS mae, 0.3234 AS rmse\n",
        "dimensions": [
          {
            "expr": "mae"
          },
          {
            "expr": "rmse"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "ac24c0db",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "avg_price_by_temperature_band",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "e53b8d8e",
                  "fields": [
                    {
                      "name": "temperature_band",
                      "expression": "`temperature_band`"
                    },
                    {
                      "name": "observation_count",
                      "expression": "`observation_count`"
                    },
                    {
                      "name": "average_price_nok_per_kwh",
                      "expression": "`average_price_nok_per_kwh`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": {
                  "value": "Average Electricity Price by Temperature Band",
                  "fields": []
                }
              },
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "temperature_band",
                  "displayName": "Temperature Band",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "custom-order",
                      "orderedValues": [
                        "-15 to -10 °C",
                        "-10 to -5 °C",
                        "-5 to 0 °C",
                        "0 to 5 °C",
                        "5 to 10 °C",
                        "10 to 15 °C",
                        "15 to 20 °C",
                        "20 to 25 °C"
                      ]
                    }
                  }
                },
                "y": {
                  "fieldName": "average_price_nok_per_kwh",
                  "displayName": "Average Price (NOK/kWh)",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "temperature_band",
                  "legend": {
                    "hide": true
                  },
                  "scale": {
                    "mappings": [
                      {
                        "color": "#0B4F8A",
                        "value": "-15 to -10 °C"
                      },
                      {
                        "color": "#2E7FB8",
                        "value": "-10 to -5 °C"
                      },
                      {
                        "color": "#85B8DC",
                        "value": "-5 to 0 °C"
                      },
                      {
                        "color": "#F2B3B3",
                        "value": "0 to 5 °C"
                      },
                      {
                        "color": "#E58A8A",
                        "value": "5 to 10 °C"
                      },
                      {
                        "color": "#D96060",
                        "value": "10 to 15 °C"
                      },
                      {
                        "color": "#C0392B",
                        "value": "15 to 20 °C"
                      },
                      {
                        "color": "#A93226",
                        "value": "20 to 25 °C"
                      }
                    ],
                    "type": "categorical"
                  }
                },
                "label": {
                  "show": true
                },
                "extra": [
                  {
                    "fieldName": "observation_count"
                  }
                ]
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 5,
            "width": 6,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "executive-summary",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "c3f9e9bd",
                  "fields": [
                    {
                      "name": "executive_summary",
                      "expression": "`executive_summary`"
                    }
                  ],
                  "disaggregated": true,
                  "orders": [
                    {
                      "direction": "ASC",
                      "expression": "`executive_summary`"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": {
                  "value": "Executive Summary of NO2 Spot Price & Weather (Jan–Jun 2025)",
                  "fields": []
                }
              },
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "executive_summary",
                    "displayName": "Executive summary"
                  }
                ],
                "rowOrder": [
                  {
                    "by": "column",
                    "field": {
                      "index": 0
                    }
                  }
                ]
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "observation_count_by_band",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dd5d92e7",
                  "fields": [
                    {
                      "name": "feature_label",
                      "expression": "`feature_label`"
                    },
                    {
                      "name": "sum(importance)",
                      "expression": "SUM(`importance`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "showDescription": false,
                "title": {
                  "value": "Price Drivers: What Impacts the NO2 Electricity Price Most?",
