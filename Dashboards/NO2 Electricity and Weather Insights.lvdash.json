                },
                "y": {
                  "fieldName": "sum(importance)",
                  "axis": {
                    "title": "Importance"
                  },
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "label": {
                  "show": true
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 7,
            "width": 6,
            "height": 5
          }
        },
