                }
              },
              "version": 3,
              "mark": {
                "colors": [
                  "#9E9E9E"
                ]
              },
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "feature_label",
                  "axis": {
                    "hideTitle": true,
                    "labelAngle": 45
                  },
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "y-reversed"
